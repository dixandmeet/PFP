# URL du site Next.js (sans slash final). Utilisée pour tous les appels /api/*
EXPO_PUBLIC_API_URL=http://localhost:3000

# Builds EAS : si non défini, __DEV__ utilise localhost et les builds release utilisent https://profootprofile.com
# Définir EXPO_PUBLIC_API_URL pour preview/staging via `eas secret:create --name EXPO_PUBLIC_API_URL --value https://...`
# ou dans eas.json > build.<profil>.env (voir profils preview / production).
#
# Node : utiliser Node 20 LTS pour Expo/EAS en local (voir .nvmrc à la racine). Node 24 casse `expo config` / `eas init`.
# Depuis la racine du monorepo : `pnpm mobile:dev` (active nvm/fnm puis lance Metro). Sinon : `nvm use` puis `pnpm --filter @pfp/mobile dev`.
#
# EAS : depuis ce dossier mobile/, après `pnpm install` à la racine du monorepo :
#   pnpm --filter @pfp/mobile eas:init
# Cela lie le projet Expo et écrit extra.eas.projectId dans app.json.
# Builds : pnpm --filter @pfp/mobile build:preview:ios | build:ios | etc.
# Soumission stores : eas submit (renseigner Apple ID, ASC App ID, équipe, clé JSON Play Console en interactif ou secrets).
#
# Notifications push : non branchées en v1 — pas d’enregistrement de token device dans l’app pour l’instant.

# Secret partagé avec le backend pour prouver l'identité de l'app mobile
# (permet de bypasser Turnstile CAPTCHA, non disponible en natif)
# Doit correspondre à MOBILE_API_SECRET côté backend
EXPO_PUBLIC_MOBILE_API_SECRET=

# Google OAuth (même client ID Web que sur le site, Google Cloud Console)
EXPO_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id
# iOS : identifiant client de type iOS + URL de redirection inverse dans la config Google
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your_google_ios_client_id
# Configurer les URI de redirection OAuth (scheme pfp) pour les builds natives :
# https://docs.expo.dev/guides/google-authentication/
